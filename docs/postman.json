              }
            ],
            "url": "{{base_url}}/api/v1/advisor/small_expenses",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"arguments\": {\n    \"start\": \"2026-10-01\",\n    \"end\": \"2026-10-31\",\n    \"threshold\": \"50.00\"\n  }\n}"
            }
          }
        },
        {
          "name": "Consulta breve en conversación",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
