          "name": "Manifiesto de herramientas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/advisor/tools",
            "description": ""
          }
        },
        {
