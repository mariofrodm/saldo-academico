    },
    {
      "name": "Opcional · Metas y movimientos",
      "description": "Ejecutar solo contra una meta creada para aceptación. Cambios reales de la base seleccionada; no ejecutar borrado sobre las metas de la demostración. El ID se guarda en goal_id manualmente después de crear.",
      "item": [
        {
          "name": "Listar metas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/goals",
            "description": ""
          }
        },
        {
          "name": "Crear meta de aceptación",
          "request": {
